#!/usr/bin/env nu

use modules/database.nu *
use modules/general.nu *

# Your own title lists in simple script!
#
# Add, view, edit and remove your titles within local lists.
# You can find database here: "~/.local/share/novelist/novelist.db"
#
# Use --help flag to view possible parameters for each subcommand.
# Example: novelist show --help
def main [] {
  help main
}

# show novelist version
def "main version" [] {
  "2.0.0"
}

# show titles in the list
@example "Show all titles from default list" { novelist show }
@example "Show all titles from movies list" { novelist show -l movies }
@example "Show titles from reading category within default list" { novelist show reading }
@example "Show titles from watching category within movies list" { novelist show watching -l movies }
@example "Show movies watching(alt. of above)" { novelist show -l movies watching }
def "main show" [category?: string --list-name(-l): string = "novels"] {
  load-database

  let list = if ($category | is-empty) {
    stor open | query db $"SELECT * FROM ($list_name)"
  } else {
    stor open | query db $"SELECT title, progress FROM ($list_name) WHERE category LIKE ?" -p [$category]
  }

  print $list
}

# add title to the list
@example "Add title to default list(novelist will ask for details)" { novelist add }
@example "Add title to default list(alt.)" { novelist add "something very fun" "chapter 12" reading }
@example "Add title to default list(alt.)" { novelist add "something very fun" 12 reading }
@example "Add title to movies list(novelist will ask for details)" { novelist add -l movies }
@example "Add title to movies list(alt.)" { novelist add -l movies "not so fun" "S1E2" dropped }
@example "Add title to movies list(alt.)" { novelist add "not so fun" "S1E2" dropped -l movies }
def "main add" [title? progress? category? --list-name(-l): string = "novels"] {
  load-database

  let title = if ($title | is-not-empty) {$title} else { input "Plese enter novel title: " }
  let progress = if ($progress | is-not-empty) {$progress} else { input "Progress: " }
  let category = if ($category | is-not-empty) {$category} else { input "Category: " }
  stor insert -t $list_name -d {title: $title, progress: $progress, category: $category}

  save-database
}

# show categories of a list
@example "Show categories of default list" { novelist categories }
@example "Show categories of movies list" { novelist categories -l movies}
def "main categories" [--list-name(-l): string = "novels"] {
  load-database

  stor open | query db $"SELECT DISTINCT category FROM ($list_name)" | print $in
}

# edit title in the list
@example "Edit title in default list, novelist will ask for details" { novelist edit }
@example "Edit title in movies list, novelist will ask for details" { novelist edit -l movies }
@example "Search for 'My title' in novels(default list) and skip questions(will not edit anything)" { novelist edit -s "My title" }
@example "Search for 'My title' in movies and skip questions(will not edit anything)" { novelist edit -s -l movies "My title" }
@example "Search for 'My title' in novels(default list), update it's progress and skip rest" { novelist edit -s "My title" "chapter 12" }
@example "Search for 'My title' in movies, update it's progress and skip rest" { novelist edit -s -l movies "My title" "episode 12" }
@example "Search for 'My title' in novels(default list), update it's progress and category, skip rest" { novelist edit -s "My title" "chapter 12" dropped }
@example "Search for 'My title' in movies, update it's progress and category, skip rest" { novelist edit -s -l movies "My title" "episode 12" dropped }
def "main edit" [title_to_edit? new_progress? new_category?
  --skip-prompt(-s) # don't change title and don't ask for ommited parameters
  --list-name(-l): string = "novels"
  ] {
  load-database

  let title = search-novel-title $title_to_edit -l $list_name

  let new_title = if ($skip_prompt) {null} else {input "New title(leave empty to skip): "}
  let new_progress = if ($skip_prompt or ($new_progress | is-not-empty)) { $new_progress } else { input "Update progress: " }
  let new_category = if ($skip_prompt or ($new_category | is-not-empty)) { $new_category } else { input "Update category: " }

  if ($new_progress | is-not-empty) {
    stor open |
      query db $"UPDATE ($list_name) SET progress = ? WHERE title LIKE ?" -p [$new_progress $title]
  }

  if ($new_category | is-not-empty) {
    stor open |
      query db $"UPDATE ($list_name) SET category = ? WHERE title LIKE ?" -p [$new_category $title]
  }

  if ($new_title | is-not-empty) {
    stor open |
      query db $"UPDATE ($list_name) SET title = ? WHERE title LIKE ?" -p [$new_title $title]
  }

  print "Updated record:"
  stor open |
    query db $"SELECT * FROM ($list_name) WHERE title LIKE ? OR title LIKE ?" -p [$title $new_title] |
    print $in

  save-database
}

# remove title from the list
@example "Search and remove title from default list" { novelist remove }
@example "Search and remove title from default list(alt.)" { novelist remove something }
@example "Search and remove title from default list(alt.)" { novelist remove "something else" }
@example "Search and remove title from movies list" { novelist remove -l movies }
@example "Search and remove title from movies list(alt.)" { novelist remove something -l movies }
@example "Search and remove title from movies list(alt.)" { novelist remove -l movies "something else" }
def "main remove" [title? --list-name(-l): string = "novels"] {
  load-database

  let title = search-novel-title $title -l $list_name

  stor open |
    query db $"DELETE FROM ($list_name) WHERE title LIKE ?" -p [$title]

  print $"Deleted \"($title)\" from ($list_name)"

  save-database
}

# show all lists
@example "Show all lists" { novelist lists }
def "main lists" [] {
  load-database
  stor open | table
}

# create new list
@example "Create movies list" { novelist create movies }
def "main create" [list_name] {
  load-database
  stor create -t $list_name -c {title: str, progress: int, category: str}
  save-database
}

# delete list and all titles associated with it
@example "Delete movies list and all titles within it" { novelist burn movies }
def "main burn" [list_name] {
  load-database
  if (confirm $"You're about to delete ($list_name) list. It's not reversable.") {
    stor open | query db $"DROP TABLE IF EXISTS ($list_name)"
    print $"Deleted ($list_name) list"
  } else {
    print $"Deletion of ($list_name) is canceled"
  }
  save-database
}
