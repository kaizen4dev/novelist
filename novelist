#!/usr/bin/env nu

use modules/database.nu *
use modules/general.nu *

# Your own novel list in simple script!
#
# Add, view, edit and remove your novels within local database.
# Database file is located at "~/.local/share/novelist/novels.db"
def main [] {
  help main
}

# list novels in database
def "main show" [category: string = "all" --list-name(-l): string = "novels"] {
  load-database

  let list = if $category == "all" {
    stor open | query db $"SELECT * FROM ($list_name)"
  } else {
    stor open | query db $"SELECT title, progress FROM ($list_name) WHERE category LIKE ?" -p [$category]
  }

  print $list
}

# add novel to the database
def "main add" [title? progress? category? --list-name(-l): string = "novels"] {
  load-database

  let title = if ($title | is-not-empty) {$title} else { input "Plese enter novel title: " }
  let progress = if ($progress | is-not-empty) {$progress} else { input "progress: " }
  let category = if ($category | is-not-empty) {$category} else { input "Category: " }
  stor insert -t $list_name -d {title: $title, progress: $progress, category: $category}

  save-database
}

# list categories
def "main categories" [] {
  load-database

  stor open | query db "SELECT DISTINCT category FROM novels" | print $in
}

# edit title in database
def "main edit" [title_to_edit? new_progress? new_category? --skip-prompt(-s)] {
  load-database

  let title = search-novel-title $title_to_edit

  let new_title = if ($skip_prompt) {null} else {input "New title(leave empty to skip): "}
  let new_progress = if ($skip_prompt or ($new_progress | is-not-empty)) { $new_progress } else { input "Update progress: " }
  let new_category = if ($skip_prompt or ($new_category | is-not-empty)) { $new_category } else { input "Update category: " }

  if ($new_progress | is-not-empty) {
    stor open |
      query db "UPDATE novels SET progress = ? WHERE title LIKE ?" -p [$new_progress $title]
  }

  if ($new_category | is-not-empty) {
    stor open |
      query db "UPDATE novels SET category = ? WHERE title LIKE ?" -p [$new_category $title]
  }

  if ($new_title | is-not-empty) {
    stor open |
      query db "UPDATE novels SET title = ? WHERE title LIKE ?" -p [$new_title $title]
  }

  print "Updated record:"
  stor open |
    query db "SELECT * FROM novels WHERE title LIKE ? OR title LIKE ?" -p [$title $new_title] |
    print $in

  save-database
}

# remove title from database
def "main remove" [title?] {
  load-database

  let title = search-novel-title $title

  stor open |
    query db "DELETE FROM novels WHERE title LIKE ?" -p [$title]
  print $"Deleted \"($title)\""

  save-database
}

# show all lists
def "main lists" [] {
  load-database
  stor open | table
}

# create new list
def "main create" [list_name] {
  load-database
  stor create -t $list_name -c {title: str, progress: int, category: str}
  save-database
}

# delete list
def "main burn" [list_name] {
  load-database
  if (confirm $"You're about to delete ($list_name) list. It's not reversable.") {
    stor open | query db $"DROP TABLE IF EXISTS ($list_name)"
    print $"Deleted ($list_name) list"
  } else {
    print $"Deletion of ($list_name) is canceled"
  }
  save-database
}
